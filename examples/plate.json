{
  "name": "plate",
  "description": "Reading-spike sketch 01: 80 x 50 x 6 plate, 4x Ø6 corner holes, Ø20 centre bore.",
  "parameters": {
    "width": {"value": 80, "description": "plate length along X", "min": 30},
    "depth": {"value": 50, "description": "plate depth along Y", "min": 30},
    "thickness": {"value": 6, "description": "plate thickness"},
    "hole_inset": {"value": 8, "description": "corner hole centre distance from the edges"},
    "hole_d": {"value": 6, "description": "corner hole diameter"},
    "bore_d": {"value": 20, "description": "centre bore diameter"}
  },
  "features": [
    {"id": "base", "type": "extrude", "plane": "XY",
     "profile": {"shape": "rect", "width": "width", "height": "depth"}, "distance": "thickness"},
    {"id": "corner_hole", "type": "hole", "face": "top", "center": ["hole_inset", "hole_inset"],
     "diameter": "hole_d", "through": true},
    {"id": "corner_holes", "type": "linear_pattern", "feature": "corner_hole",
     "count_u": 2, "spacing_u": "width - 2 * hole_inset", "count_v": 2, "spacing_v": "depth - 2 * hole_inset"},
    {"id": "bore", "type": "hole", "face": "top", "center": ["width / 2", "depth / 2"],
     "diameter": "bore_d", "through": true}
  ]
}
